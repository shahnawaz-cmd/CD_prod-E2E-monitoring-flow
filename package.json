{
  "name": "cd-monitoring-flow",
  "version": "1.0.0",
  "description": "E2E Production Stability Monitoring Flow for Classic Decoder",
  "scripts": {
    "test": "playwright test",
    "test:safari": "playwright test --project=\"Mobile Safari\"",
    "test:chrome": "playwright test --project=\"Desktop Chrome\"",
    "test:mobile-chrome": "playwright test --project=\"Mobile Chrome\"",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
